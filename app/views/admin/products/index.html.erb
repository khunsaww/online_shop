<% content_for :title, "商品 | 管理画面" %>
<h1>商品</h1>
<%= link_to "商品を追加", new_admin_product_path, class: "button" %>
<table class="data-table">
  <thead>
    <tr>
      <th>商品</th>
      <th>カテゴリ</th>
      <th>公開</th>
      <th>価格</th>
      <th>在庫</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td>
          <div class="product-name-cell">
            <%= product_image_tag product, alt: product.name, class: "product-thumb" %>
            <span><%= product.name %></span>
          </div>
        </td>
        <td><%= product.category.name %></td>
        <td><%= product.published? ? "公開" : "非公開" %></td>
        <td><%= yen(product.display_price) %></td>
        <td><span class="<%= stock_class(product.stock_status) %>"><%= product.stock_status %></span></td>
        <td>
          <%= link_to "詳細", admin_product_path(product) %>
          <%= link_to "編集", edit_admin_product_path(product) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
