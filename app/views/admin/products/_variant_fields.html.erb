<fieldset class="variant-fields">
  <legend>選択肢</legend>
  <%= f.label :option_kind_id, "種類" %>
  <%= f.collection_select :option_kind_id, OptionKind.all, :id, :name %>
  <%= f.label :label, "ラベル" %>
  <%= f.text_field :label, placeholder: "500g" %>
  <%= f.label :price, "販売価格（税込）" %>
  <%= f.number_field :price, min: 1 %>
  <%= f.label :stock, "在庫数" %>
  <%= f.number_field :stock, min: 0 %>
  <% if f.object.persisted? %>
    <% if f.object.ordered? %>
      <p class="muted">注文で参照されているため削除できません。在庫を0にすると販売を止められます。</p>
    <% else %>
      <label><%= f.check_box :_destroy %> この選択肢を削除</label>
    <% end %>
  <% end %>
</fieldset>
