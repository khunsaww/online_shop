<% content_for :title, "カテゴリ | 管理画面" %>
<h1>カテゴリ</h1>
<%= link_to "カテゴリを追加", new_admin_category_path, class: "button" %>
<table class="data-table">
  <thead>
    <tr>
      <th>並び順</th>
      <th>名前</th>
      <th>商品数</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.position %></td>
        <td><%= category.name %></td>
        <td><%= category.products.count %></td>
        <td>
          <%= link_to "編集", edit_admin_category_path(category) %>
          <%= button_to "削除", admin_category_path(category), method: :delete %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
